# ------------------------------------------------------------------
# SentiTrack AI Frontend — environment template. Copy to .env and fill in.
# All variables must be prefixed with VITE_ to be exposed to client code.
# ------------------------------------------------------------------

# App metadata
VITE_APP_NAME=SentiTrack AI
VITE_APP_ENV=production

# Backend API
# Root of the deployed FastAPI service (no trailing slash).
VITE_API_ROOT_URL=https://your-backend-url.example.com
# Feature endpoints live under /api/v1 on the backend.
VITE_API_V1_PREFIX=/api/v1
# Request timeout in milliseconds (AI endpoints can be slow on Render's free tier).
VITE_API_TIMEOUT_MS=45000

# Backend connectivity indicator (footer status dot)
VITE_ENABLE_HEALTH_CHECK=true
VITE_HEALTH_CHECK_INTERVAL_MS=60000

# Contact form (frontend-only until a backend contact endpoint exists)
VITE_CONTACT_EMAIL=hello@example.com
